OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Used by compose.yaml to configure the postgres service and derive DATABASE_URL
# for the migrations/api containers (which always target the in-network "postgres" host).
POSTGRES_DB=my_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
