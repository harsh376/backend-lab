OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Used by compose/base.yaml to configure PostgreSQL and the database settings
# for migrations/API containers, which target the in-network "postgres" host.
POSTGRES_DB=my_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Shared by the API producer and Celery workers inside Compose.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2

# Temporal and answer retrieval inside the Compose network.
# Host processes use Settings defaults (localhost); these files are Compose inputs.
TEMPORAL_ADDRESS=temporal:7233
ELASTICSEARCH_URL=http://elasticsearch:9200
KILT_INDEX=kilt

# Optional Langfuse tracing; create project API keys in your Langfuse instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_TRACING_ENABLED=true
